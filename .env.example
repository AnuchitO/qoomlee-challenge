# Copy this file to .env and fill in values before running docker compose

# ── Database ──────────────────────────────────
# qoomlee-service connects to postgres-qoomlee (POSTGRES_QOOMLEE_DB)
# payment-service connects to postgres-qoomlee-payment (POSTGRES_PAYMENT_DB)
POSTGRES_QOOMLEE_DB=qoomlee
POSTGRES_PAYMENT_DB=qoomlee_payment
POSTGRES_USER=qoomlee
POSTGRES_PAYMENT_USER=qoomlee_payment
POSTGRES_PASSWORD=qoomlee

# ── Omise Payment Gateway (test keys) ─────────
# Get yours at https://dashboard.omise.co/test/api-keys
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxxxx

# ── JWT RS256 (stateless auth) ────────────────
# All services verify incoming JWTs using JWT_PUBLIC_KEY.
# JWT_PRIVATE_KEY is only needed for test tooling (make jwt-token).
# Use \n to encode newlines in a single-line value.
#
# Generate your own pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Example test keys (DO NOT use in production):
