# Copy this file to .env and fill in values before running docker compose

# ── Database ──────────────────────────────────
# qoomlee-service connects to postgres-qoomlee (POSTGRES_QOOMLEE_DB)
# payment-service connects to postgres-qoomlee-payment (POSTGRES_PAYMENT_DB)
POSTGRES_QOOMLEE_DB=qoomlee
POSTGRES_PAYMENT_DB=qoomlee_payment
POSTGRES_USER=qoomlee
POSTGRES_PAYMENT_USER=qoomlee_payment
POSTGRES_PASSWORD=qoomlee

# ── Omise Payment Gateway (test keys) ─────────
# Get yours at https://dashboard.omise.co/test/api-keys
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxxxx

# ── Internal Service-to-Service Secret ────────
# payment-service sends this header when calling PUT /api/bookings/:ref/status
# qoomlee-service rejects calls without this exact value
# Generate a strong random value: openssl rand -hex 32
# For development, you can use this default:
INTERNAL_TOKEN=dev-internal-token-for-testing

# ── CORS ───────────────────────────────────────
# Comma-separated list of origins allowed to call qoomlee-service.
ALLOWED_ORIGINS=http://localhost:3000

# ── Caddy (TLS reverse proxy) ──────────────────
# Public hostname Caddy requests a TLS cert for, e.g. api-dev.<vm-ip>.sslip.io.
# Defaults to "localhost" for local dev.
CADDY_HOSTNAME=localhost

# ── Web app (app/web/.env.local) ───────────────
# Copy the block below into app/web/.env.local for local development.
# These are NEXT_PUBLIC_ variables — they are embedded in the browser bundle.
#
# NEXT_PUBLIC_QOOMLEE_API_URL=http://localhost:8082
# NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8084
# NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxxxx   ← from OMISE_PUBLIC_KEY above
# NEXT_PUBLIC_ENABLE_TEST_SCENARIOS=true
