# ── Internal Service-to-Service Secret ────────
# payment-service sends this header when calling PUT /api/bookings/:ref/status
# qoomlee-service rejects calls without this exact value
# Generate a strong random value: openssl rand -hex 32
# For development, you can use this default:
INTERNAL_TOKEN=dev-internal-token-for-testing

# ── CORS ───────────────────────────────────────
# Comma-separated list of origins allowed to call qoomlee-service.
ALLOWED_ORIGINS=http://localhost:3000
