title: Qoomlee Airline — MVP Use Case Diagram {
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

direction: right

# ── Actors ────────────────────────────────────────────────────────────────────
passenger: Passenger {
  shape: person
}

omise: "Omise\nPayment Gateway" {
  shape: cloud
}

# ── System boundary ───────────────────────────────────────────────────────────
system: Qoomlee Booking REST API {
  style.stroke-dash: 4

  # Flight domain
  uc1: "UC1\nSearch Flights" {
    shape: oval
    style.fill: "#e8f4fd"
  }
  uc2: "UC2\nView Flight Detail" {
    shape: oval
    style.fill: "#e8f4fd"
  }

  # Booking domain
  uc3: "UC3\nCreate Booking\n→ receive PNR" {
    shape: oval
    style.fill: "#e8f8e8"
  }
  uc5: "UC5\nView Booking & PNR" {
    shape: oval
    style.fill: "#e8f8e8"
  }

  # Payment domain
  uc4: "UC4\nPay for Booking" {
    shape: oval
    style.fill: "#fff3e0"
  }
  uc6: "UC6\nView Payment Receipt" {
    shape: oval
    style.fill: "#fff3e0"
  }

  # Internal (service-to-service only, not called by passenger)
  uc7: "UC7\nUpdate Booking Status\n(PENDING → CONFIRMED)\n«internal»" {
    shape: oval
    style.fill: "#f5f5f5"
    style.stroke-dash: 4
  }
}

# ── Passenger associations ────────────────────────────────────────────────────
passenger -> system.uc1
passenger -> system.uc2
passenger -> system.uc3
passenger -> system.uc4
passenger -> system.uc5
passenger -> system.uc6

# ── External system associations ──────────────────────────────────────────────
system.uc4 -> omise: "«include»\ncharge card"

# ── Internal dependency ───────────────────────────────────────────────────────
system.uc4 -> system.uc7: "«include»\non success"

# ── Endpoint mapping legend ───────────────────────────────────────────────────
legend: Endpoint Mapping {
  shape: text
  near: bottom-left
  style.font-size: 13
  label: |||md
    | Use Case | Endpoint | Status |
    |---|---|---|
    | UC1 | GET /api/flights/search | ✅ working |
    | UC2 | GET /api/flights/:id | 🔨 build |
    | UC3 | POST /api/bookings | ✅ working |
    | UC4 | POST /api/payments/charge | ✅ working |
    | UC5 | GET /api/bookings/:ref | 🔨 build |
    | UC6 | GET /api/payments/:ref | 🔨 build |
    | UC7 | PUT /api/bookings/:ref/status | 🔨 build (internal) |
  |||
}
