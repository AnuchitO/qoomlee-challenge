# Copy to secret.env (git-ignored) and apply with:
#   kubectl create secret generic qoomlee-secret \
#     --from-env-file=secret.env --namespace=qoomlee-dev --dry-run=client -o yaml | kubectl apply -f -
#   kubectl create secret generic payment-secret \
#     --from-env-file=secret.payment.env --namespace=qoomlee-dev --dry-run=client -o yaml | kubectl apply -f -

# secret.env (qoomlee-secret)
POSTGRES_PASSWORD=changeme
INTERNAL_TOKEN=dev-internal-token-changeme

# secret.payment.env (payment-secret)
POSTGRES_PAYMENT_PASSWORD=changeme
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx
INTERNAL_TOKEN=dev-internal-token-changeme
