# Copy to secret.env / secret.payment.env (git-ignored), then apply:
#   kubectl create secret generic qoomlee-secret \
#     --from-env-file=secret.env --namespace=qoomlee-prod --dry-run=client -o yaml | kubectl apply -f -
#   kubectl create secret generic payment-secret \
#     --from-env-file=secret.payment.env --namespace=qoomlee-prod --dry-run=client -o yaml | kubectl apply -f -

# secret.env (qoomlee-secret)
POSTGRES_PASSWORD=<strong-random-value>
INTERNAL_TOKEN=<openssl rand -hex 32>

# secret.payment.env (payment-secret)
POSTGRES_PAYMENT_PASSWORD=<strong-random-value>
OMISE_PUBLIC_KEY=pkey_live_xxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_live_xxxxxxxxxxxxxxxxxxxx
INTERNAL_TOKEN=<same value as qoomlee-secret INTERNAL_TOKEN>
